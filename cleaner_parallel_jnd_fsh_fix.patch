Date: Wed, 7 Oct 2026 03:05:46 +0000
Subject: [PATCH] fix: preserve narrative coverage and status-only responses

---
 functions/board_to_log/contracts.py |  1 +
 functions/board_to_log/coverage.py  | 10 ++++--
 functions/board_to_log/extractor.py | 51 ++++++++++++++++++++++++++---
 pipeline/weekly_report_pipeline.py  |  1 +
 unit_tests/test_board_to_log.py     | 25 ++++++++++++++
 unit_tests/test_coverage_audit.py   |  6 ++--
 6 files changed, 85 insertions(+), 9 deletions(-)

diff --git a/functions/board_to_log/contracts.py b/functions/board_to_log/contracts.py
